# --- Search providers (configure at least one) ---
# Google Cloud Vision (Web Detection). https://console.cloud.google.com -> enable "Cloud Vision API" -> Credentials -> API key
GOOGLE_VISION_API_KEY=
# TinEye commercial API. https://services.tineye.com/TinEyeAPI -> buy a search bundle -> API key
TINEYE_API_KEY=
# SerpApi Google Lens. https://serpapi.com/manage-api-key  (requires PUBLIC_BASE_URL reachable from the internet)
SERPAPI_API_KEY=
PUBLIC_BASE_URL=

# --- Infrastructure ---
DATABASE_URL=sqlite:///./data/mirror.db
# postgresql+psycopg://mirror:mirror@localhost:5432/mirror
SECRET_KEY=change-me-to-a-long-random-string
DATA_DIR=./data
MAX_UPLOAD_MB=10
UPLOAD_RETENTION_MINUTES=30
RATE_LIMIT_SEARCHES_PER_HOUR=30
RESPECT_ROBOTS_TXT=true
